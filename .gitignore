# Gradle Build & Cache
/.gradle/
/build/
/out/

# Fabric / Dev Laufzeit (generiert durch gradlew runClient)
/run/
/run/logs/
/run/telemetry/
/run/downloads/
/run/*.log
/run/*.log.gz

