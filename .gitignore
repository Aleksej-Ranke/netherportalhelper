# IDE: IntelliJ IDEA
/.idea/
*.iml

# IDE: Eclipse
/.classpath
/.project
/.settings/

# IDE: VS Code
/.vscode/

# Logs überall
*.log
*.log.gz

# Betriebssystem / Editor Artefakte
.DS_Store
Thumbs.db

# JVM Crash / Replay Files
hs_err_pid*
replay_pid*

# Stray JARs im Projektroot (Build liegt bereits unter /build/libs)
/netherportalhelper-*.jar

# Export / Hilfsdateien
/export_classpath.json

